# Exemplo de variáveis de ambiente do ReMed (ADR 0020).
# Copie este arquivo para `.env` na raiz do projeto e preencha valores locais reais.
# NUNCA versione o arquivo `.env` nem coloque segredos reais aqui.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-segura
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (ADR 0002) ---
POSTGRES_DB=remed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-pela-senha-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- E-mail (ADR 0015) ---
# Em desenvolvimento local, o padrão com DJANGO_DEBUG=True é console.EmailBackend.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nao-responda@remed.local

# --- Armazenamento privado local (ADR 0016) ---
# Em desenvolvimento e testes fica fora de static/ e sem rota pública.
REMED_PRIVATE_STORAGE_ROOT=private_media

# --- Parâmetros de negócio (opcionais; possuem valores padrão em core/settings.py) ---
REMED_TERMOS_VERSAO_ATUAL=1.0-rascunho
REMED_SESSION_COOKIE_AGE=1800
REMED_LOGIN_MAX_TENTATIVAS=5
REMED_LOGIN_JANELA_MINUTOS=15
REMED_LOGIN_BLOQUEIO_MINUTOS=15
REMED_NOTIFICACAO_EMAIL_LIMITE_HORA=20
REMED_RESERVA_EXPIRACAO_HORAS=48
REMED_CORRESPONDENCIA_ACEITE_HORAS=48
REMED_REFRIGERADO_JANELA_MAX_MINUTOS=120
REMED_CADASTRO_LIMITE_IP_HORA=5
REMED_CEP_RATE_LIMIT_IP_MINUTO=30
REMED_CEP_TIMEOUT_SEGUNDOS=3
